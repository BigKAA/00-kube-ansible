# Конфигурация для single-node кластера
# Скопируйте в group_vars/k8s_cluster и настройте под своё окружение

kube_version: 1.36.1
cni: cilium

# HA отключён — не задавайте ha_cluster_virtual_ip для single-node

# Утилиты — отключены для минимальной установки (кроме Metrics Server)
nfsEnable: false
certManagerEnable: false
metricsServerEnable: true
metallbEnable: false
argoCDEnable: false

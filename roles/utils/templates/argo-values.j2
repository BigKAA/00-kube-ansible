crds:
  keep: false

global:
  # Переопределение registry/образа для всех компонентов ArgoCD
  # (controller/server/repoServer/applicationSet наследуют global.image).
  image:
    repository: {{ argocdImageRegistry }}/{{ argocdImageRepository }}
  # Глобальный pull-secret для приватного registry
{% if (utils_global_image_pull_secrets | default([])) | length > 0 %}
  imagePullSecrets:
{% for s in utils_global_image_pull_secrets %}
    - name: {{ s.name }}
{% endfor %}
{% endif %}
  logging:
    format: json
    # -- Set the global logging level. One of: `debug`, `info`, `warn` or `error`
    level: {{ argoCDLoglevel }}

controller:
  replicas: {{ argoCDControllerReplicaCount }}

configs:
  cm:
    application.resourceTrackingMethod: {{ argoCDTrackingMethod }}
    controller.diff.server.side: "{{ argoCDEnableServerSideDiff }}"
    ignoreAggregatedRoles: {{ argoCDIgnoreAggregateRoles}}
    url: https://{{ argoCDURL }}

  params:
    server.insecure: true

  repositories:
    artur-repo:
      url: https://github.com/BigKAA/youtube
      name: bigkaa
      type: git

  secret:
    # -- Bcrypt hashed admin password
    ## Argo expects the password in the secret to be bcrypt hashed. You can create this hash with
    ## `htpasswd -nbBC 10 "" $ARGO_PWD | tr -d ':\n' | sed 's/$2y/$2a/'`
    argocdServerAdminPassword: "{{ argoCDAdminPassword }}"

## Redis
redis:
  enabled: true
  # Переопределение образа Redis (для закрытого окружения)
  image:
    repository: {{ argocdRedisImageRegistry }}/{{ argocdRedisImageRepository }}
    tag: {{ argocdRedisImageTag }}

## Dex-server
# Переопределение образа dex (для закрытого окружения)
dex:
  image:
    repository: {{ argocdDexImageRegistry }}/{{ argocdDexImageRepository }}
    tag: {{ argocdDexImageTag }}

## Server
server:
  name: server
  replicas: {{ argoCDServerReplicaCount }}
  certificate:
    enabled: true
    domain: "{{ argoCDURL }}"
    duration: "9125h"
    renewBefore: "360h"
    issuer:
      group: "cert-manager.io"
      kind: "ClusterIssuer"
      name: "dev-ca-issuer"
    privateKey:
      rotationPolicy: Always
      encoding: PKCS8
      algorithm: RSA
      size: 4096
    usages:
      - server auth
      - client auth

  ingress:
    enabled: true
    controller: generic
    annotations:
      cert-manager.io/cluster-issuer: "dev-ca-issuer"
      nginx.ingress.kubernetes.io/ssl-redirect: "false"
    ingressClassName: "system-ingress"
    hostname: "{{ argoCDURL }}"
    paths:
      - /
    pathType: Prefix
    tls: true
